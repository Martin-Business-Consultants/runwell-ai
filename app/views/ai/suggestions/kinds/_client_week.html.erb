<%# locals: (suggestion:, frame_id:) %>
<div class="ai-message"><%= ai_text(suggestion.payload["summary"]) %></div>
<div class="ai-suggestion__actions">
  <%= button_to "Save as a note", ai_suggestion_path(suggestion), method: :patch, params: { decision: "accept" }, class: "ui-button", data: { variant: "default", size: "sm" }, form: { data: { turbo_frame: "_top" } } %>
  <%= ui :button, variant: :outline, size: :sm, content: "Copy", data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: suggestion.payload["summary"].to_s, action: "copy-to-clipboard#copy", runeui_toast: { title: "Copied" }.to_json } %>
  <%= render "ai/suggestions/dismiss", suggestion: suggestion, frame_id: frame_id %>
</div>
