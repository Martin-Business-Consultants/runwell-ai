<%# locals: (suggestion:, frame_id:) %>
<% p = suggestion.payload %>
<% decline = p["action"].in?(%w[decline delete]) %>
<% owner = User.people.active.find_by(id: p["owner_id"]) unless decline %>
<p class="ai-suggestion__headline">
  <% if decline %>
    <strong>Decline it</strong>
  <% elsif owner %>
    <strong>Accept it for <%= owner.display_name %></strong><% if p["due_on"].present? %> · by <%= l(Date.parse(p["due_on"]), format: :long) rescue p["due_on"] %><% end %>
  <% else %>
    <strong>Accept it</strong> <span class="ai-suggestion__meta">(no one on the team fits)</span>
  <% end %>
</p>
<p class="ai-suggestion__meta"><%= p["reason"] %></p>
<% if p["out_of_scope"] %>
  <p><%= ui :badge, variant: :warning, content: "Beyond what its #{term(:work).downcase} covers" %></p>
<% end %>
<div class="ai-suggestion__actions">
  <% if decline || owner %>
    <%= button_to "Do this", ai_suggestion_path(suggestion), method: :patch, params: { decision: "accept" }, class: "ui-button", data: { variant: "default", size: "sm" }, form: { data: { turbo_frame: "_top" } } %>
  <% end %>
  <%= render "ai/suggestions/dismiss", suggestion: suggestion, frame_id: frame_id %>
</div>
