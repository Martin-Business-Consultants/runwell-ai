<%# locals: (suggestion:, frame_id:) %>
<% p = suggestion.payload %>
<% owner = User.people.active.find_by(id: p["owner_id"]) if p["action"] == "assign" %>
<p class="margin-none">
  <% if p["action"] == "delete" %>
    <strong>Delete it</strong>
  <% elsif owner %>
    <strong>Assign it to <%= owner.display_name %></strong><% if p["due_on"].present? %> · by <%= l(Date.parse(p["due_on"]), format: :long) rescue p["due_on"] %><% end %>
  <% else %>
    <strong>Assign it</strong> <span class="txt-subtle">(no one on the team fits)</span>
  <% end %>
</p>
<p class="txt-small txt-subtle margin-none"><%= p["reason"] %></p>
<% if p["out_of_scope"] %>
  <p class="txt-small margin-none"><span class="status-tag status-tag--waiting">Beyond what its engagement covers</span></p>
<% end %>
<div class="flex gap-half">
  <% if (p["action"] == "delete" && can?(:delete_records)) || owner %>
    <%= button_to "Do this", ai_suggestion_path(suggestion), method: :patch, params: { decision: "accept" }, class: "btn btn--link txt-small", form: { data: { turbo_frame: "_top" } } %>
  <% end %>
  <%= render "ai/suggestions/dismiss", suggestion: suggestion, frame_id: frame_id %>
</div>
