<%# locals: (suggestion:, frame_id:) %>
<% tasks = Array(suggestion.payload["tasks"]) %>
<% if tasks.empty? %>
  <p class="ai-suggestion__meta">No <%= term(:task, count: 2).downcase %> or promises in this note.</p>
<% else %>
  <%= form_with url: ai_suggestion_path(suggestion), method: :patch, class: "ai-suggestion__form", data: { turbo_frame: "_top" } do %>
    <% tasks.each_with_index do |item, index| %>
      <%# herb:key "t#{index}" %>
      <% ref = item["work_ref"].presence || item["engagement_ref"] %>
      <%= ui :checkbox, name: "items[]", value: "tasks-#{index}", checked: true, id: "#{frame_id}_#{index}",
            label: [ item["title"], ref.presence, ("by #{item["due_on"]}" if item["due_on"].present?) ].compact.join(" · ") %>
    <% end %>
    <input type="hidden" name="decision" value="accept">
    <div class="ai-suggestion__actions">
      <%= ui :button, type: :submit, size: :sm, content: "Add the ticked ones" %>
    </div>
  <% end %>
<% end %>
<div class="ai-suggestion__actions"><%= render "ai/suggestions/dismiss", suggestion: suggestion, frame_id: frame_id %></div>
