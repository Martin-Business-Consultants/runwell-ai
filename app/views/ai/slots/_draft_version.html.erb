<%# locals: (version:) %>
<%# Under a draft agreement: scope to add, and a check before it's sent. Never on an internal one. %>
<% engagement = version.engagement %>
<% if !engagement.internal? && Ai.available_for?(engagement) %>
  <div class="flex flex-column gap-half ai-suggestions">
    <%= render "ai/suggestions/card", kind: "scope_draft", subject: engagement, suggestion: AiSuggestion.latest("scope_draft", engagement, Current.user) %>
    <% if version.scope_items.any? %>
      <%= render "ai/suggestions/card", kind: "agreement_check", subject: engagement, suggestion: AiSuggestion.latest("agreement_check", engagement, Current.user) %>
    <% end %>
  </div>
<% end %>
