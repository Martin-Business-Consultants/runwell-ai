<%# locals: (record:) %>
<%# A record's sidebar (the core's :record_aside slot): the suggestions this kind of record takes,
    and on a client the switch that keeps it out of AI. %>
<% if Ai.ready? %>
  <% if record.is_a?(Client) && can?(:manage_settings) %>
    <%= render "ai/exclusions/switch", client: record %>
  <% end %>
  <% if Ai.available_for?(record) %>
    <% kinds =
         case record
         when Request then (record.open? && can?(:triage_requests) ? %w[triage] : [])
         when Engagement then (record.draft_version && !record.internal? ? (record.draft_version.scope_items.any? ? %w[scope_draft agreement_check] : %w[scope_draft]) : [])
         when ScopeItem then %w[plan_work]
         when Client then (record.internal? ? [] : %w[client_week])
         else []
         end %>
    <% if kinds.any? %>
      <section class="settings__section flex flex-column gap-half">
        <% kinds.each do |kind| %>
          <%# herb:key kind %>
          <%= render "ai/suggestions/card", kind: kind, subject: record, suggestion: AiSuggestion.latest(kind, record, Current.user) %>
        <% end %>
      </section>
    <% end %>
  <% end %>
<% end %>
