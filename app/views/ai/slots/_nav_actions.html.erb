<%# locals: () %>
<%# The Ask panel (the :nav_actions slot): a button in the nav's foot (i) opening a drawer at the
    right of the window (ui :drawer) that loads the person's chat about the record on screen. %>
<% if Ai.ready? %>
  <% record = current_record %>
  <% trigger = ui(:button, variant: :ghost, size: :icon_sm, title: "Ask AI (i)", aria: { label: "Ask AI" }, data: { keys: "i" }, content: icon_tag("ai")) %>
  <%= ui :drawer, id: "ai_drawer", trigger: trigger, title: "Ask AI", class: "ai-drawer" do %>
    <turbo-frame id="ai_panel" src="<%= ai_current_chat_path(record: (Ai.ref(record) if record), page: controller_path) %>" loading="lazy" class="ai-drawer__frame">
      <%= ui :skeleton, class: "ai-drawer__loading" %>
    </turbo-frame>
  <% end %>
<% end %>
