<%# locals: (client:) %>
<%# A client's sidebar: the week with them, and the switch that keeps them out of AI. %>
<% if Ai.ready? && !client.internal? %>
  <%= ui :card, class: "ai-aside", title: tag.h2("AI", class: "ai-aside__title") do %>
    <% if Ai.available_for?(client) %>
      <%= render "ai/suggestions/card", kind: "client_week", subject: client, suggestion: AiSuggestion.latest("client_week", client, Current.user) %>
    <% end %>
    <% if Ai.excluded?(client) %>
      <%= button_to ai_client_exclusion_path(client), method: :delete, class: "ui-button", data: { variant: "ghost", size: "sm" }, form_class: "ai-aside__button" do %>
        <%= icon_tag "ai" %> <span>Kept out of AI: let it back</span>
      <% end %>
    <% else %>
      <%= button_to ai_client_exclusion_path(client), class: "ui-button", data: { variant: "ghost", size: "sm" }, form_class: "ai-aside__button" do %>
        <%= icon_tag "ai" %> <span>Keep out of AI</span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
