<%# locals: (chat:, title:, messages_path:, new_chat_path:, new_chat_params:, prompts:, documents:, note:) %>
<%# The Ask panel's inside, for staff (ai/chats) and the client portal (portal/ai_chats): its title, the
    conversation (reloading while a reply comes), one-click questions, and the box to ask in. %>
<div class="ai-chat">
  <header class="ai-chat__header">
    <h2 class="ai-chat__title"><%= title %></h2>
    <%= button_to new_chat_path, params: new_chat_params, class: "ui-button", data: { variant: "ghost", size: "icon-sm" }, title: "Start a new chat", aria: { label: "Start a new chat" } do %>
      <%= icon_tag "add" %>
    <% end %>
  </header>

  <turbo-frame id="ai_messages" src="<%= messages_path %>" class="ai-chat__messages">
    <%= ui :skeleton, shape: :text %>
  </turbo-frame>

  <% if flash[:alert] %>
    <%= ui :alert, variant: :destructive, description: flash[:alert] %>
  <% end %>

  <% if chat.ai_messages.none? %>
    <div class="ai-chat__prompts">
      <% prompts.each do |prompt| %>
        <%# herb:key prompt %>
        <%= button_to prompt, messages_path, params: { message: { content: prompt } }, class: "ui-button ai-chat__prompt", data: { variant: "outline", size: "sm" } %>
      <% end %>
    </div>
  <% end %>

  <% if chat.proposals.any? %>
    <p class="ai-chat__note">Approve or decline the change above, and it carries on.</p>
  <% else %>
    <%= form_with url: messages_path, scope: :message, class: "ai-chat__form", data: { controller: "form" } do |form| %>
      <div class="ai-chat__compose">
        <%= form.ui :textarea, :content, rows: 2, required: true, class: "ai-chat__input", placeholder: "Ask, or ask it to do something…", autofocus: true,
              aria: { label: "Your question" }, data: { action: "keydown.meta+enter->form#submit keydown.ctrl+enter->form#submit" } %>
        <% if documents.any? %>
          <%= ui :collapsible, trigger: "Include documents", class: "ai-chat__documents" do %>
            <% documents.each do |document| %>
              <%# herb:key document.id %>
              <%= ui :checkbox, name: "message[document_ids][]", value: document.id, label: document.filename.to_s, id: dom_id(document, :ai) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <%= ui :button, type: :submit, size: :sm, content: "Send", data: { form_target: "submit" } %>
    <% end %>
  <% end %>
  <p class="ai-chat__note"><%= note %></p>
</div>
