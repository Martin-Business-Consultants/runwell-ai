<turbo-frame id="ai_panel">
  <div class="ai-chat">
    <% if can?(:manage_settings) %>
      <%= ui :empty, size: :sm, title: "AI isn’t switched on here", description: "Set it up in Settings › Plugins › AI.",
            action: ui(:button, href: settings_ai_path, variant: :outline, size: :sm, content: "AI settings", data: { turbo_frame: "_top" }) %>
    <% else %>
      <%= ui :empty, size: :sm, title: "AI isn’t switched on here", description: "An owner can switch it on in Settings › Plugins › AI." %>
    <% end %>
  </div>
</turbo-frame>
