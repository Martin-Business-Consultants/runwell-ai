<% subject = @chat.subject %>
<% title = subject.nil? ? "Ask anything" : (subject.try(:title) || subject.try(:name) || subject.try(:description)) %>
<turbo-frame id="ai_panel">
  <%= render "ai/chats/panel", chat: @chat, title: title, messages_path: ai_chat_messages_path(@chat), new_chat_path: ai_chats_path, new_chat_params: { record: (Ai.ref(subject) if subject) },
        prompts: ai_prompts(subject, params[:page]), documents: @chat.attachable_documents, note: "It acts as you, and asks before changing anything." %>
</turbo-frame>
